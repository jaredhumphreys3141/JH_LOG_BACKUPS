nts/867500072/image-20260310-215319.png?version=3D1&amp;modificationDate=3D=
1773179602676&amp;cacheVersion=3D1&amp;api=3Dv2" data-height=3D"312" data-w=
idth=3D"349" data-unresolved-comment-count=3D"0" data-linked-resource-id=3D=
"1177387009" data-linked-resource-version=3D"1" data-linked-resource-type=
